{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Практика 1: суммы (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/practice01.exe",
      "args": [
        "--size",
        "1048576"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "value": "${config:course.toolchainBin};${env:PATH}",
          "name": "PATH"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${config:course.toolchainBin}/gdb.exe",
      "setupCommands": [
        {
          "description": "Allow GCC standard-library debugger helpers",
          "text": "-interpreter-exec console \"add-auto-load-safe-path ${config:course.toolchainBin}/libstdc++-6.dll-gdb.py\"",
          "ignoreFailures": true
        },
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "C++20: build",
      "linux": {
        "environment": [],
        "program": "${workspaceFolder}/build/debug/practice01",
        "miDebuggerPath": "/usr/bin/gdb"
      }
    },
